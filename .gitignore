# MSBuild / Visual Studio build outputs (generated by building a sample).
[Rr]elease/
[Dd]ebug/
x64/
x86/
*.xex
*.xex.*
*.xdb
*.obj
*.pdb
*.ilk
*.exp
*.lib
*.tlog
*.lastbuildstate
*.log
*.idb

# Binary sample assets live in git only as packed parts under assets\ (see
# tools\Manage-Assets.ps1). The raw files are materialised by `unpack` and stay
# untracked. Keep this list in sync with $AssetExt in Manage-Assets.ps1.
*.xpr
*.xpr2
*.xzp
*.tga
*.bmp
*.dds
*.png
*.jpg
*.jpeg
*.gif
*.wav
*.xma
*.xma2
*.wmv
*.mov
*.mp4
*.bik
*.ttf
*.x
*.xed
*.oc
*.pmem
*.xbg
*.xatg
*.abc
*.bin
*.xpv
*.xsb
*.xwb
*.xgs
*.wma
*.ico
# ...but keep the committed asset parts themselves.
!assets/*.part.*
!assets/assets.manifest

# Generated by the spac pre-build step (from *.gameconfig).
*.spa
*.spa.h

# VS user/local state
.vs/
*.user
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb

# build sweep output
build-report.txt
retest-report.txt

# Compiled shader microcode (generated by the fxc RxdkGen steps)
Media/Shaders/*.xvu
Media/Shaders/*.xpu
**/Media/Shaders/*.xvu
**/Media/Shaders/*.xpu

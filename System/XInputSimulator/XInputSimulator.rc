// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_XSIMSAMPLE          ICON                    "XInputSimulator.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDC_XSIMSAMPLE ACCELERATORS 
BEGIN
    "P",            ID_ACC_PLAY_START,      VIRTKEY, CONTROL, NOINVERT
    "P",            ID_ACC_PLAY_STOP,       VIRTKEY, SHIFT, CONTROL, NOINVERT
    "M",            ID_ACC_RANDOM_START,    VIRTKEY, CONTROL, NOINVERT
    "M",            ID_ACC_RANDOM_STOP,     VIRTKEY, SHIFT, CONTROL, NOINVERT
    "R",            ID_ACC_RECORD_START,    VIRTKEY, CONTROL, NOINVERT
    "R",            ID_ACC_RECORD_STOP,     VIRTKEY, SHIFT, CONTROL, NOINVERT
    VK_BACK,        ID_ACC_RETURN_CTL,      VIRTKEY, CONTROL, NOINVERT
    "T",            ID_ACC_TEXT_SEND,       VIRTKEY, CONTROL, NOINVERT
    VK_F1,          ID_HELP_HELP,           VIRTKEY, NOINVERT
END


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_XSIMSAMPLE_DIALOG DIALOGEX 0, 0, 425, 290
STYLE DS_SETFONT | DS_MODALFRAME | DS_3DLOOK | DS_FIXEDSYS | WS_MINIMIZEBOX | WS_CAPTION | WS_SYSMENU
CAPTION "XSim Remote Sample"
MENU IDR_MENU
CLASS "XSimSample"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "T&ype a target file name or choose one from the list:",IDC_STATIC,7,9,281,101
    EDITTEXT        IDC_FILENAME,14,24,118,12,ES_LOWERCASE | ES_AUTOHSCROLL
    PUSHBUTTON      "&Delete",IDC_BTN_DELFILE,135,23,38,14
    LISTBOX         IDC_LIST_FILES,14,41,158,62,LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    GROUPBOX        "File Recorder (R)",IDC_STATIC,177,20,103,44
    PUSHBUTTON      "Start",IDC_STARTRECORDER,183,32,45,16
    PUSHBUTTON      "Stop",IDC_STOPRECORDER,231,32,45,16
    CTEXT           "[ -- RECORDING -- ]",IDC_RECORDER_STATE,183,51,93,9,NOT WS_VISIBLE
    GROUPBOX        "File Player (P)",IDC_STATIC,177,67,103,38
    PUSHBUTTON      "Start",IDC_PLAYBACK,183,80,45,16
    PUSHBUTTON      "Stop",IDC_STOPPLAYBACK,231,80,45,16
    GROUPBOX        "&Active Port",IDC_STATIC,295,9,123,63,0,WS_EX_TRANSPARENT
    LISTBOX         IDC_LIST_PORTS,301,20,106,43,LBS_SORT | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    GROUPBOX        "Random Input Player (M)",IDC_STATIC,295,76,123,34
    PUSHBUTTON      "Start",IDC_START_RANDOMINPUT,297,89,54,16
    PUSHBUTTON      "Stop",IDC_STOP_RANDOMINPUT,355,89,54,16
    GROUPBOX        "&Text Sequence Player (T)",IDC_STATIC,7,114,411,39
    COMBOBOX        IDC_TEXTSEQUENCE_COMBO,14,129,286,30,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Send",IDC_SEND_TEXTSEQUENCE,305,128,41,16
    CONTROL         "<a>Format reference</a>",IDC_TEXTSEQUENCE_FORMAT,
                    "SysLink",WS_TABSTOP | 0x2,351,133,60,9
    GROUPBOX        "Output Window:",IDC_STATIC,7,156,411,127
    CONTROL         "",IDC_OUTPUT,"RichEdit20A",ES_MULTILINE | ES_AUTOHSCROLL | ES_READONLY | WS_BORDER | WS_VSCROLL,14,172,393,105
END

IDD_QUICKHELP DIALOGEX 0, 0, 214, 136
STYLE DS_SYSMODAL | DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Quick help"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,162,120,50,14
    LTEXT           "Ctrl + R",IDC_STATIC,18,18,26,8
    GROUPBOX        "Keyboard accelerators:",IDC_STATIC,7,7,203,107
    LTEXT           "Ctrl + Shift + R",IDC_STATIC,18,30,50,8
    LTEXT           "Ctrl + P",IDC_STATIC,18,42,26,8
    LTEXT           "Ctrl + M",IDC_STATIC,18,66,27,8
    LTEXT           "Ctrl + Shift + P",IDC_STATIC,18,54,50,8
    LTEXT           "Ctrl + Shift + M",IDC_STATIC,18,78,51,8
    LTEXT           "Start recording on the selected file",IDC_STATIC,84,18,112,8
    LTEXT           "Stop the file recorder",IDC_STATIC,84,30,69,8
    LTEXT           "Start playback on the selected file",IDC_STATIC,84,42,110,8
    LTEXT           "Stop the file player",IDC_STATIC,84,54,62,8
    LTEXT           "Start the random input player",IDC_STATIC,84,66,96,8
    LTEXT           "Stop the random input player",IDC_STATIC,84,78,94,8
    LTEXT           "Ctrl + T",IDC_STATIC,18,90,26,8
    LTEXT           "Send the selected text sequence",IDC_STATIC,84,90,106,8
    LTEXT           "Ctrl + Backspace",IDC_STATIC,18,102,55,8
    LTEXT           "Return control of all ports to console",IDC_STATIC,84,102,118,8
END



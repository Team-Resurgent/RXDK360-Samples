/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MENU MENU 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "Clear &output",               ID_FILE_CLEAROUTPUT
        MENUITEM "&Refresh files",              ID_FILE_REFRESHFILES
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_FILE_EXIT
    END
    POPUP "&Console"
    BEGIN
        MENUITEM "&Return control",             ID_CONSOLE_RETURNCONTROL
        POPUP "&Sync mode"
        BEGIN
            MENUITEM "&Frame",                      ID_SYNCMODE_FRAME, CHECKED
            MENUITEM "&Time",                       ID_SYNCMODE_TIME
        END
        MENUITEM "&Disable guide button",       ID_CONSOLE_DISABLEGUIDEBUTTON, CHECKED
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&Text sequence format",       ID_HELP_TEXTSEQUENCEHELP
        MENUITEM "&Quick help",                 ID_HELP_QUICKHELP
        MENUITEM "&Help",                       ID_HELP_HELP
    END
END



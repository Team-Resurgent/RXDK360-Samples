@echo off

REM -----------------------------------------------------------------------------
REM This batch file is used to generate temporary files to test Game Disc caching
REM
REM Game Technology Group.
REM Copyright (C) Microsoft Corporation. All rights reserved.
REM -----------------------------------------------------------------------------

SET FILE_NAME_CNT=0

:FILE_LOOP

IF %FILE_NAME_CNT% EQU 10 GOTO :EOF

SET FILE_NAME=test_file%FILE_NAME_CNT%.bin

IF EXIST %FILE_NAME% del /q %FILE_NAME%

echo Generating Game Disc Caching File: %FILE_NAME%

FOR /L %%I IN (1,1,500) DO echo XXXXXXXXXXXXXXXXXXXXXXXXX test file  >> %FILE_NAME%

SET /A FILE_NAME_CNT=%FILE_NAME_CNT%+1

GOTO FILE_LOOP


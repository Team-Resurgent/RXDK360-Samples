<Window x:Class="PDBScope.PDBViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:XGS="clr-namespace:PDBScope"
    xmlns:s="clr-namespace:System.Collections;assembly=mscorlib"
    xmlns:p="clr-namespace:System;assembly=mscorlib"
    Title="PDBScope" Height="530" Width="755" >

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Open}"
                    Executed="OpenPDBFile"
                    CanExecute="CanExecuteOpen"/>
        <CommandBinding Command="{x:Static ApplicationCommands.Close}"
                    Executed="CloseApplication"
                    CanExecute="CanCloseApplication"/>
    </Window.CommandBindings>

    <Window.Resources>
        <DataTemplate x:Key="HeaderTemplateArrowUp">
            <DockPanel>
                <TextBlock HorizontalAlignment="Center" Text="{Binding}"/>
                <Path x:Name="arrow"
                   StrokeThickness = "1"                      
                   Fill            = "gray"
                   Data            = "M 5,10 L 15,10 L 10,5 L 5,10"/>
            </DockPanel>
        </DataTemplate>
        <DataTemplate x:Key="HeaderTemplateArrowDown">
            <DockPanel>
                <TextBlock HorizontalAlignment="Center" Text="{Binding }"/>
                <Path x:Name="arrow"
                      StrokeThickness = "1"                   
                      Fill            = "gray"
                      Data            = "M 5,5 L 10,10 L 15,5 L 5,5"/>
          </DockPanel>
        </DataTemplate>
        
        <!--
        This style is used on rectangles that show where users can grab the display to resize the grids. For oomparison, one
        rectangle is defined inline and the rest are defined using the style.
        -->
        <Style TargetType="Rectangle" 
               x:Key="RectangleGradient">
            <Setter Property="Height" Value="10" />
            <Setter Property="VerticalAlignment" Value="bottom" />
            <Setter Property="Fill">
                <Setter.Value>
                    <RadialGradientBrush>
                        <GradientBrush.GradientStops>
                            <GradientStopCollection>
                                <GradientStop Color="sc#0.300000, 0.000000, 0.000000, 0.000000" Offset="0.019230769230769232" />
                                <GradientStop Color="#FFFFFFFF" Offset="1" />
                            </GradientStopCollection>
                        </GradientBrush.GradientStops>
                        <Brush.RelativeTransform>
                            <TransformGroup>
                                <TransformGroup.Children>
                                    <TransformCollection>
                                        <TranslateTransform X="-0.0052816901408450721" Y="0.5185185185185186" />
                                    </TransformCollection>
                                </TransformGroup.Children>
                            </TransformGroup>
                        </Brush.RelativeTransform>
                    </RadialGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <!--
    Resizable areas are created by embedding Grids within DockPanels. The Dock Panels set the LastChildFile to true so the last child
    expanded to take up all the available room in the outter container. For items, like the search box and progress bar, that are not to
    be resized their columns are given explicit height values. For the items that are to resize, like the ListViews, their columns are 
    given a size of '*'. 
    -->
    <DockPanel LastChildFill="true" >
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Files" Width="75">
                <MenuItem Header="Open" Command="ApplicationCommands.Open"/>
                <MenuItem Header="Close" Command="ApplicationCommands.Close"/>
            </MenuItem>
        </Menu>

        <DockPanel DockPanel.Dock="Bottom" LastChildFill="True">
            <DockPanel DockPanel.Dock="Top" Margin="20">
                <TextBlock FontSize="14" Width="60" DockPanel.Dock="Left" Height="23.338" HorizontalAlignment="Center">Search:</TextBlock>
                <ComboBox x:Name="SearchCombo" Text="" StaysOpenOnEdit="False" AllowDrop="True" IsEditable="True" DockPanel.Dock="Right"  
                                  SelectionChanged="SearchCombo_SelectionChanged" 
                                  KeyUp="OnKeyDownHandler">
                    <ComboBoxItem></ComboBoxItem>
                    <ComboBoxItem></ComboBoxItem>
                    <ComboBoxItem></ComboBoxItem>
                    <ComboBoxItem></ComboBoxItem>
                    <ComboBoxItem></ComboBoxItem>
                    <ComboBoxItem></ComboBoxItem>
                    <ComboBoxItem></ComboBoxItem>
                    <ComboBoxItem></ComboBoxItem>
                </ComboBox>
            </DockPanel>
            <DockPanel DockPanel.Dock="Bottom" LastChildFill="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="20" />
                    </Grid.RowDefinitions>
                    <TabControl DockPanel.Dock="Top" Grid.Row="0"
                                SelectionChanged="DisplayTabChanged"
                                Name="TopLevelSymbolLists">
                        <TabItem Header="Types">
                            <DockPanel LastChildFill="True">
                                <Grid Margin="20,20,20,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="5" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- <Rectangle Fill="white" RadiusX="14" RadiusY="14" Margin="0,0,0,8"    StrokeDashArray="2"/> -->
                                    <ListView  x:Name="typeView" 
                                               Grid.Row="0" 
                                               SelectionChanged="myTypeChanged" 
                                               SelectionMode="Single" 
                                               GridViewColumnHeader.Click="PrimaryGridViewColumnHeaderClickedHandler">
                                    </ListView>
                                    <!-- 
                                    Rectangles are used to highlight where people grap the display to resize the grids. To show how  
                                    styles can be used to remove redundant declarations the first rectangle is declared inline and the
                                    rest use styles. 
                                    -->
                                    <Rectangle Grid.Row="1" Height="10" VerticalAlignment="bottom" >
                                        <Shape.Fill>
                                            <RadialGradientBrush>
                                                <GradientBrush.GradientStops>
                                                    <GradientStopCollection>
                                                        <GradientStop Color="sc#0.300000, 0.000000, 0.000000, 0.000000" Offset="0.019230769230769232" />
                                                        <GradientStop Color="#FFFFFFFF" Offset="1" />
                                                    </GradientStopCollection>
                                                </GradientBrush.GradientStops>
                                                <Brush.RelativeTransform>
                                                    <TransformGroup>
                                                        <TransformGroup.Children>
                                                            <TransformCollection>
                                                                <TranslateTransform X="-0.0052816901408450721" Y="0.5185185185185186" />
                                                            </TransformCollection>
                                                        </TransformGroup.Children>
                                                    </TransformGroup>
                                                </Brush.RelativeTransform>
                                            </RadialGradientBrush>
                                        </Shape.Fill>
                                    </Rectangle>
                                    <GridSplitter Grid.Row="1" Grid.RowSpan="1" Margin="10,0,10,0" Opacity="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="Auto" Height="5" Background="White" Cursor="SizeNS"/>
                                    <TabControl  Grid.Row="2">
                                        <TabItem Header="Fields">
                                            <ListView  x:Name="typeFieldView">
                                            </ListView>
                                        </TabItem>
                                        <TabItem Header="Declared In">
                                            <DockPanel LastChildFill="True">
                                                <Grid Margin="20,20,20,0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="5" />
                                                        <RowDefinition Height="*"  />
                                                    </Grid.RowDefinitions>

                                                    <Rectangle Fill="white" RadiusX="14" RadiusY="14" Margin="0,0,0,8"    StrokeDashArray="2"/>
                                                    <ListView  x:Name="typeFunctionView" 
                                                       Grid.Row="0" 
                                                       SelectionChanged="myTypeFunctionChanged"
                                                       SelectionMode="Single" 
                                                       GridViewColumnHeader.Click="TypeFunctionGridViewColumnHeaderClickedHandler" >
                                                    </ListView>
                                                    <Rectangle Grid.Row="1" 
                                                               Style="{StaticResource RectangleGradient}" />
                                                    <GridSplitter Grid.Row="1" Grid.RowSpan="1" 
                                                                  Margin="10,0,10,0" Opacity="0" 
                                                                  HorizontalAlignment="Stretch" 
                                                                  VerticalAlignment="Stretch" 
                                                                  Width="Auto" Height="5" 
                                                                  Background="White" Cursor="SizeNS"/>
                                                    <ListView  x:Name="typeFunctionLocalsView" 
                                                               Grid.Row="2" 
                                                               GridViewColumnHeader.Click="TypeFunctionLocalsGridViewColumnHeaderClickedHandler">
                                                    </ListView>
                                                </Grid>
                                            </DockPanel>
                                        </TabItem>
                                    </TabControl>
                                </Grid>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Global Data">
                            <DockPanel LastChildFill="True">
                                <Grid Margin="20,20,20,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="5" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <ListView  x:Name="globalDataView" 
                                               Grid.Row="0" 
                                               SelectionChanged="myGlobalDataChanged"
                                               GridViewColumnHeader.Click="PrimaryGridViewColumnHeaderClickedHandler">
                                    </ListView>
                                    <Rectangle Grid.Row="1" 
                                               Style="{StaticResource RectangleGradient}" />
                                    <GridSplitter Grid.Row="1" Grid.RowSpan="1" Margin="10,0,10,0" Opacity="0" 
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="Auto" 
                                                  Height="5" Background="White" Cursor="SizeNS"/>
                                    <ListView  x:Name="globalDataFieldView"
                                               Grid.Row="2">
                                    </ListView>
                                </Grid>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="File Static Data">
                            <DockPanel LastChildFill="True">
                                <Grid Margin="20,20,20,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="5" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <ListView  x:Name="fileStaticDataView"
                                               Grid.Row="0"
                                               SelectionChanged="myFileStaticDataChanged"
                                               GridViewColumnHeader.Click="PrimaryGridViewColumnHeaderClickedHandler">
                                    </ListView>
                                    <Rectangle Grid.Row="1" 
                                               Style="{StaticResource RectangleGradient}" />
                                    <GridSplitter Grid.Row="1" Grid.RowSpan="1" Margin="10,0,10,0" Opacity="0" 
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                                                  Width="Auto" Height="5" Background="White" Cursor="SizeNS"/>
                                    <ListView  x:Name="fileStaticDataFieldView"
                                               Grid.Row="2">
                                    </ListView>
                                </Grid>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Constant Static Data">
                            <DockPanel LastChildFill="True">
                                <Grid Margin="20,20,20,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="5" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <ListView  x:Name="constantStaticDataView" 
                                               Grid.Row="0"
                                               SelectionChanged="myConstantStaticDataChanged"
                                               GridViewColumnHeader.Click="PrimaryGridViewColumnHeaderClickedHandler">
                                    </ListView>
                                    <Rectangle Grid.Row="1" 
                                               Style="{StaticResource RectangleGradient}" />
                                    <GridSplitter Grid.Row="1" Grid.RowSpan="1" Margin="10,0,10,0" Opacity="0" 
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                                                  Width="Auto" Height="5" Background="White" Cursor="SizeNS"/>
                                    <ListView  x:Name="constantStaticDataFieldView"
                                               Grid.Row="2">
                                    </ListView>
                                </Grid>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Functions">
                            <DockPanel LastChildFill="True">
                                <Grid Margin="20,20,20,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="3" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- <Rectangle Fill="white" RadiusX="14" RadiusY="14" Margin="0,0,0,8"    StrokeDashArray="2"/> -->
                                    <ListView  x:Name="functionView" 
                                               Grid.Row="0" 
                                               SelectionChanged="myFunctionChanged" 
                                               SelectionMode="Single" 
                                               GridViewColumnHeader.Click="PrimaryGridViewColumnHeaderClickedHandler">
                                    </ListView>
                                    <Rectangle Grid.Row="1" 
                                               Style="{StaticResource RectangleGradient}" />
                                    <GridSplitter Grid.Row="1" Grid.RowSpan="1" Margin="10,0,10,0" Opacity="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="Auto" Height="5" Background="White" Cursor="SizeNS"/>
                                    <TabControl DockPanel.Dock="Bottom"  Grid.Row="2">
                                        <TabItem Header="Referenced Data">
                                            <ListView  x:Name="functionLocalsView" 
                                                       GridViewColumnHeader.Click="FunctionReferencedDataGridViewColumnHeaderClickedHandler">
                                            </ListView>
                                        </TabItem>
                                    </TabControl>
                                </Grid>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                    <StatusBar DockPanel.Dock="Bottom" Name="sbar" Grid.Row="1" VerticalAlignment="Bottom" Background="White" Visibility="Hidden">
                        <StatusBarItem>
                            <TextBlock>Loading Types</TextBlock>
                        </StatusBarItem>
                        <StatusBarItem>
                            <ProgressBar Width="500" Height="15" Name="progressBar1" Maximum="1000">
                            </ProgressBar>
                        </StatusBarItem>
                    </StatusBar>
                </Grid>
            </DockPanel>
        </DockPanel>
    </DockPanel>
</Window>
